# Copy to .env (git-ignored). Never commit the real file.

# Vault repository. SSH form needs KB_SSH_KEY_FILE; HTTPS form needs KB_GIT_TOKEN.
KB_GIT_REMOTE=git@github.com:me/my-notes.git
KB_GIT_BRANCH=main

# Bearer token clients must send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
KB_HTTP_TOKEN=

# Password for the OAuth sign-in page used by apps that cannot send a static
# token (Claude iOS/Android/web connectors). Generate: openssl rand -base64 18
KB_OAUTH_PASSWORD=
# Public HTTPS URL of the server when exposed through Cloudflare Tunnel or a
# reverse proxy (used as the OAuth issuer). Optional.
KB_PUBLIC_URL=

# Where the published port binds on the host. Keep 127.0.0.1 unless a TLS
# proxy or private network protects the port.
KB_BIND=127.0.0.1
KB_PORT=8765

# One of the two credential methods:
KB_SSH_KEY_FILE=/home/me/.config/knowledge-base-mcp/deploy_key
KB_GIT_TOKEN=

KB_LOG_LEVEL=info
KB_PULL_INTERVAL=60s
KB_INSTANCE_ID=home-server

# --- Multi-user mode (optional) ---------------------------------------------
# Setting KB_ADMIN_EMAIL turns on accounts, several repositories and
# folder-level access rules (docs/multi-user.md). Leave it empty for the
# classic single-vault server; the four values below are then ignored.
KB_ADMIN_EMAIL=
# Mail provider (Resend) API key with "Sending access" only, and a sender on a
# domain verified with the provider.
KB_RESEND_API_KEY=
KB_MAIL_FROM="KB <login@mail.example.com>"
# Encrypts repository tokens and SSH keys at rest. Generate: openssl rand -base64 32
KB_SECRET_KEY=
# Alias of the vault above once it becomes the first repository.
KB_VAULT_ALIAS=main
