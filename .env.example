# Copy to .env (git-ignored). Never commit the real file.

# Vault repository. SSH form needs KB_SSH_KEY_FILE; HTTPS form needs KB_GIT_TOKEN.
KB_GIT_REMOTE=git@github.com:me/my-notes.git
KB_GIT_BRANCH=main

# Bearer token clients must send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
KB_HTTP_TOKEN=

# Where the published port binds on the host. Keep 127.0.0.1 unless a TLS
# proxy or private network protects the port.
KB_BIND=127.0.0.1
KB_PORT=8765

# One of the two credential methods:
KB_SSH_KEY_FILE=/home/me/.config/knowledge-base-mcp/deploy_key
KB_GIT_TOKEN=

KB_LOG_LEVEL=info
KB_PULL_INTERVAL=60s
KB_INSTANCE_ID=home-server
